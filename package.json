{
  "name": "aeris-wind-desk",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"python -m uvicorn server.app:app --reload --host 127.0.0.1 --port 3001\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "python -m uvicorn server.app:app --host 0.0.0.0 --port 3001",
    "test": "python -m pytest -q",
    "test:mongo": "python -m scripts.verify_deployment",
    "ingest": "python -m scripts.ingest",
    "seed": "python -m scripts.seed",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
